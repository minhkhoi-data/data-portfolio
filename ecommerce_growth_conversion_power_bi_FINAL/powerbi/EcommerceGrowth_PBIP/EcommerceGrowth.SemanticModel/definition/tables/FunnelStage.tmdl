/// Disconnected display table that controls funnel stage order.
table FunnelStage
	lineageTag: e7bf9d43-f79c-40bc-a7a2-8bf98c4ee274

	column Stage
		lineageTag: d234fc2d-8364-4f71-b616-311b381f4fa7
		isNameInferred
		sourceColumn: [Stage]

	column Sort
		lineageTag: 79efc93d-72d1-4705-aaa2-4ab9ec041a21
		isNameInferred
		sourceColumn: [Sort]

	partition FunnelStage = calculated
		mode: import
		source = DATATABLE("Stage", STRING, "Sort", INTEGER, {{"Sessions",1},{"Product View",2},{"Add to Cart",3},{"Checkout",4},{"Purchase",5}})

