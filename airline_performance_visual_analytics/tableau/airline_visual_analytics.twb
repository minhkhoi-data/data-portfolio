      <column caption='Weighted Departure OTP' datatype='real' default-format='p0.0%' name='[Calculation_1948632462917632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sectors_Flown]) = 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    SUM([Departures_On_Time]) / SUM([Sectors_Flown])&#13;&#10;END' />
      </column>
      <column caption='Weighted Arrival OTP' datatype='real' default-format='p0.0%' name='[Calculation_1948632463171585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sectors_Flown]) = 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    SUM([Arrivals_On_Time]) / SUM([Sectors_Flown])&#13;&#10;END' />
      </column>
      <column caption='Weighted Cancellation Rate' datatype='real' default-format='p0.0%' name='[Calculation_1948632463392770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sectors_Scheduled]) = 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    SUM([Cancellations]) / SUM([Sectors_Scheduled])&#13;&#10;END' />
      </column>
