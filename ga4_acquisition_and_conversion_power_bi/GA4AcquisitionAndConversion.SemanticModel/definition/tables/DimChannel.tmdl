table DimChannel

	column channel_id
		dataType: int64
		summarizeBy: none
		sourceColumn: channel_id

	column channel
		dataType: string
		summarizeBy: none
		sourceColumn: channel

	partition DimChannel = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/dim_channel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {
						{"channel_id", Int64.Type},
						{"channel", type text}
					}, "en-US")
				in
					Typed
