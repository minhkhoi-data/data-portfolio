model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects

annotation PBI_QueryOrder = ["DataFolder", "FactSessions", "FactPurchases", "DimDate", "DimChannel", "DimDevice", "FunnelStage"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table FactSessions
ref table FactPurchases
ref table DimDate
ref table DimChannel
ref table DimDevice
ref table FunnelStage

ref expression DataFolder
