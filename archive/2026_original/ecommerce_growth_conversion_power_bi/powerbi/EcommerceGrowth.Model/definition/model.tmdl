model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects

annotation PBI_QueryOrder = ["DataFolder", "FactSessions", "FactPurchases", "DimDate", "DimChannel", "DimDevice", "DimGeo", "FunnelStage", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table FactSessions
ref table FactPurchases
ref table DimDate
ref table DimChannel
ref table DimDevice
ref table DimGeo
ref table FunnelStage
ref table _Measures

ref expression DataFolder
