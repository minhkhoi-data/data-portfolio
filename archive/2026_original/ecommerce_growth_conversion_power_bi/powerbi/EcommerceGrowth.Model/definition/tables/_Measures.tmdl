table _Measures
	lineageTag: 01eedc35-38de-524f-813f-1750809d42f9

	measure 'Sessions' = COALESCE(DISTINCTCOUNT(FactSessions[session_id]), 0)
		lineageTag: 9118a5a3-0277-5f36-af91-b4ca0c4204ce
		formatString: #,##0

	measure 'Users' = COALESCE(DISTINCTCOUNT(FactSessions[user_id]), 0)
		lineageTag: 82568927-4c67-5df3-8e64-bcd2149d3599
		formatString: #,##0

	measure 'Engaged Sessions' = CALCULATE([Sessions], FactSessions[engaged_session] = 1)
		lineageTag: 0227eee0-f8f1-5977-9917-8f9fdfb5e3db
		formatString: #,##0

	measure 'Known Engagement Sessions' = CALCULATE([Sessions], FactSessions[engagement_known] = 1)
		lineageTag: 3f142f4f-27c3-530b-828d-8ec5d3db9057
		formatString: #,##0

	measure 'Engagement Rate' = DIVIDE([Engaged Sessions], [Known Engagement Sessions])
		lineageTag: deff6664-5e1d-5b21-a4e6-e0da91cba591
		formatString: 0.00%

	measure 'Product View Sessions' = CALCULATE([Sessions], FactSessions[ordered_view_item] = 1)
		lineageTag: eb239d53-2ee5-5761-b786-23248d64862f
		formatString: #,##0

	measure 'Add to Cart Sessions' = CALCULATE([Sessions], FactSessions[ordered_add_to_cart] = 1)
		lineageTag: 8c7b9af5-0279-5668-9dc3-dd56d225d82f
		formatString: #,##0

	measure 'Checkout Sessions' = CALCULATE([Sessions], FactSessions[ordered_begin_checkout] = 1)
		lineageTag: 76d0b0d2-6f5a-5e2c-b1b9-22b77fc5d990
		formatString: #,##0

	measure 'Strict Journey Purchase Sessions' = CALCULATE([Sessions], FactSessions[ordered_purchase] = 1)
		lineageTag: 9adb5d5e-1f6a-58ab-baaf-a72c09782a82
		formatString: #,##0

	measure 'Purchase Sessions' = CALCULATE([Sessions], FactSessions[purchase] = 1)
		lineageTag: f72f28ce-8ad4-5d50-a2cb-a7fcf708bac7
		formatString: #,##0

	measure 'Product View Rate' = DIVIDE([Product View Sessions], [Sessions])
		lineageTag: ce903d34-af66-5b08-b0e9-d8df3eeb4a62
		formatString: 0.00%

	measure 'View to Cart Rate' = DIVIDE([Add to Cart Sessions], [Product View Sessions])
		lineageTag: 54c4f7fd-f9f3-57e6-ae79-59630a11f48d
		formatString: 0.00%

	measure 'Cart to Checkout Rate' = DIVIDE([Checkout Sessions], [Add to Cart Sessions])
		lineageTag: 76457faf-ef02-5040-91a0-0eb33969e077
		formatString: 0.00%

	measure 'Checkout to Purchase Rate' = DIVIDE([Strict Journey Purchase Sessions], [Checkout Sessions])
		lineageTag: 338f4d91-8331-56ca-924b-b4bca8d0e406
		formatString: 0.00%

	measure 'Session Conversion Rate' = DIVIDE([Purchase Sessions], [Sessions])
		lineageTag: 1867a5c8-0695-52c2-baf8-e64745cbccae
		formatString: 0.00%

	measure 'Revenue' = SUM(FactPurchases[purchase_revenue_usd])
		lineageTag: e99b48a1-a963-5204-8ea4-d77da2b03946
		formatString: $#,##0.00

	measure 'Purchase Events' = COALESCE(COUNTROWS(FactPurchases), 0)
		lineageTag: 9e75a7f6-51a1-5f38-9e3d-b17df4876517
		formatString: #,##0

	measure 'Average Purchase Event Value' = DIVIDE([Revenue], [Purchase Events])
		lineageTag: f6468fa3-5d2d-5b05-8522-e23f141405ea
		formatString: $#,##0.00

	measure 'Session-attributed Revenue' = SUM(FactSessions[session_revenue])
		lineageTag: 7e75b3db-2dde-5004-a2d9-d001181cb85c
		formatString: $#,##0.00

	measure 'Revenue per Session' = DIVIDE([Session-attributed Revenue], [Sessions])
		lineageTag: 2336501a-6ed3-52ce-91fa-9936cda683af
		formatString: $#,##0.00

	measure 'Revenue per User' = DIVIDE([Session-attributed Revenue], [Users])
		lineageTag: 774986a9-dec5-5330-8434-621f7d178024
		formatString: $#,##0.00

	measure 'Reported Item Quantity' = SUM(FactPurchases[total_quantity])
		lineageTag: 303eb08a-2b2e-5d1d-9afc-f325d3e9658e
		formatString: #,##0

	measure 'Purchasers' = COALESCE(DISTINCTCOUNT(FactPurchases[user_id]), 0)
		lineageTag: b07d4d02-3677-564f-b667-367b2bce437b
		formatString: #,##0

	measure 'Multiple-event Purchasers' = VAR Activity = ADDCOLUMNS(VALUES(FactPurchases[user_id]), "__Events", CALCULATE(COUNTROWS(FactPurchases))) RETURN COUNTROWS(FILTER(Activity, [__Events] > 1))
		lineageTag: 45bcc23a-0ebb-54a6-ae32-ae10ef65150e
		formatString: #,##0

	measure 'Multiple-event Purchaser Share' = DIVIDE([Multiple-event Purchasers], [Purchasers])
		lineageTag: f47e602e-b2e3-5d77-a8eb-1333198db91e
		formatString: 0.00%

	measure 'New User Session Conversion' = DIVIDE(CALCULATE([Purchase Sessions], FactSessions[is_new_user] = 1), CALCULATE([Sessions], FactSessions[is_new_user] = 1))
		lineageTag: b7058db6-d435-5106-bff4-3dc5f9678070
		formatString: 0.00%

	measure 'Returning User Session Conversion' = DIVIDE(CALCULATE([Purchase Sessions], FactSessions[is_new_user] = 0), CALCULATE([Sessions], FactSessions[is_new_user] = 0))
		lineageTag: 28f3636d-dd8d-5a68-a730-f8fb333aea14
		formatString: 0.00%

	measure 'Funnel Stage Sessions' = SWITCH(SELECTEDVALUE(FunnelStage[Stage]), "Sessions", [Sessions], "Product View", [Product View Sessions], "Add to Cart", [Add to Cart Sessions], "Checkout", [Checkout Sessions], "Purchase", [Strict Journey Purchase Sessions])
		lineageTag: 6a29d8ef-a602-520e-ad54-d2e41996ccd3
		formatString: #,##0

	measure 'Revenue Previous Month' = VAR FullMonth = HASONEVALUE(DimDate[year_month]) && COUNTROWS(VALUES(DimDate[date])) = DAY(EOMONTH(MAX(DimDate[date]), 0)) VAR StartPrevious = EOMONTH(MAX(DimDate[date]), -2) + 1 VAR EndPrevious = EOMONTH(MAX(DimDate[date]), -1) RETURN IF(FullMonth, CALCULATE([Revenue], REMOVEFILTERS(DimDate), DATESBETWEEN(DimDate[date], StartPrevious, EndPrevious)), BLANK())
		lineageTag: 5002659e-9fc2-5dac-bc10-36a83a3137b2
		formatString: $#,##0.00

	measure 'Revenue MoM %' = DIVIDE([Revenue] - [Revenue Previous Month], [Revenue Previous Month])
		lineageTag: dbddbc21-a129-5bdd-ae3d-a83ca83de7b0
		formatString: 0.00%

	measure 'Product Data Status' = "No item-level data"
		lineageTag: 77154261-46c3-5011-ad6b-817e73172a93

	measure 'Experiment Data Status' = "No assignment data"
		lineageTag: 45730439-7ef9-5fb3-bbee-fccefebab0ce

	measure 'Attribution Scope' = "First-user acquisition"
		lineageTag: 73b04b23-98c8-5d6d-a348-184b07333cbe

	measure 'Revenue Scope' = "Recorded purchase events"
		lineageTag: ed022cbb-cf9f-503b-9a6d-50b83e52a516

	measure 'Snapshot Note' = "Google GA4 public sample | Nov 2020 - Jan 2021 | USD purchase-event revenue | Obfuscated data"
		lineageTag: e9768452-6da4-5aaf-9108-a634a7285f83
	column Dummy
		isHidden
		dataType: string
		lineageTag: eaec6b4e-9502-540c-9d92-c159fe1d8a53
		summarizeBy: none
		sourceColumn: Dummy

	partition _Measures = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/measures.csv"), [Delimiter=",", Columns=1, Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Checked = if Table.ColumnNames(Headers) = {"Dummy"} then Headers else error Error.Record("SchemaMismatch", "CSV headers do not match _Measures", null),
					Typed = Table.TransformColumnTypes(Checked, {
					{"Dummy", type text}
					}, "en-US")
				in
					Typed
