	partition FactSessions = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/fact_sessions.csv"), [Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Checked = if Table.ColumnNames(Headers) = {"session_id", "user_id", "session_date", "channel_id", "device_id", "geo_id", "source", "medium", "is_new_user", "engagement_known", "engaged_session", "engagement_seconds", "pageviews", "view_item", "add_to_cart", "begin_checkout", "purchase", "ordered_view_item", "ordered_add_to_cart", "ordered_begin_checkout", "ordered_purchase", "event_count", "purchase_event_count", "session_revenue"} then Headers else error Error.Record("SchemaMismatch", "CSV headers do not match FactSessions", null),
					Nulls = Table.ReplaceValue(Checked, "", null, Replacer.ReplaceValue, {"engaged_session"}),
					Typed = Table.TransformColumnTypes(Nulls, {
					{"session_id", type text},
					{"user_id", type text},
					{"session_date", type date},
					{"channel_id", Int64.Type},
					{"device_id", Int64.Type},
					{"geo_id", Int64.Type},
					{"source", type text},
					{"medium", type text},
					{"is_new_user", Int64.Type},
					{"engagement_known", Int64.Type},
					{"engaged_session", Int64.Type},
					{"engagement_seconds", type number},
					{"pageviews", Int64.Type},
					{"view_item", Int64.Type},
					{"add_to_cart", Int64.Type},
					{"begin_checkout", Int64.Type},
					{"purchase", Int64.Type},
					{"ordered_view_item", Int64.Type},
					{"ordered_add_to_cart", Int64.Type},
					{"ordered_begin_checkout", Int64.Type},
					{"ordered_purchase", Int64.Type},
					{"event_count", Int64.Type},
					{"purchase_event_count", Int64.Type},
					{"session_revenue", Currency.Type}
					}, "en-US")
				in
					Typed
