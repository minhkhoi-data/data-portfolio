table DimDate
	lineageTag: 5d8c871f-f986-5e75-aa8c-3061df11b09c

	dataCategory: Time

	column date
		dataType: dateTime
		lineageTag: a0c0bddd-0269-5020-8d7e-189a8dc92374
		summarizeBy: none
		sourceColumn: date
		formatString: yyyy-MM-dd
		isKey

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		lineageTag: 5212b77c-f13c-5b48-90d0-c405e0c22da7
		summarizeBy: none
		sourceColumn: year

	column month_no
		dataType: int64
		lineageTag: 7e90444e-7ae2-5a71-b2c5-f0fd7ddd1f7b
		summarizeBy: none
		sourceColumn: month_no

	column month
		dataType: string
		lineageTag: 6adefac4-0499-55be-acba-7e1c4122a706
		summarizeBy: none
		sourceColumn: month
		sortByColumn: month_no

	column year_month
		dataType: string
		lineageTag: f891b731-3a0f-5535-9b94-367d0433cfd0
		summarizeBy: none
		sourceColumn: year_month

	column week_start
		dataType: dateTime
		lineageTag: c60731b6-e6ec-57ef-bd34-7d2e5cf03037
		summarizeBy: none
		sourceColumn: week_start
		formatString: yyyy-MM-dd

		annotation UnderlyingDateTimeDataType = Date

	column day_of_week
		dataType: string
		lineageTag: 1cc9b7a3-bd51-52d2-a254-9fa21510808d
		summarizeBy: none
		sourceColumn: day_of_week
		sortByColumn: day_of_week_no

	column day_of_week_no
		dataType: int64
		lineageTag: cc5740d3-f7c1-5058-9461-bfec06e9ea42
		summarizeBy: none
		sourceColumn: day_of_week_no

	column is_weekend
		dataType: int64
		lineageTag: 90e4c8db-8ff7-59b0-9335-429633f04cf2
		summarizeBy: none
		sourceColumn: is_weekend

	partition DimDate = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/dim_date.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Checked = if Table.ColumnNames(Headers) = {"date", "year", "month_no", "month", "year_month", "week_start", "day_of_week", "day_of_week_no", "is_weekend"} then Headers else error Error.Record("SchemaMismatch", "CSV headers do not match DimDate", null),
					Typed = Table.TransformColumnTypes(Checked, {
					{"date", type date},
					{"year", Int64.Type},
					{"month_no", Int64.Type},
					{"month", type text},
					{"year_month", type text},
					{"week_start", type date},
					{"day_of_week", type text},
					{"day_of_week_no", Int64.Type},
					{"is_weekend", Int64.Type}
					}, "en-US")
				in
					Typed
