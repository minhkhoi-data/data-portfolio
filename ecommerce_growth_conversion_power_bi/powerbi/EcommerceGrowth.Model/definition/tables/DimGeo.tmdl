table DimGeo
	lineageTag: d7e3fa54-1023-50da-9d08-829fa9e1f95b

	column geo_id
		dataType: int64
		lineageTag: 964f1883-4ed0-5a79-8b97-ec74f186cb9a
		summarizeBy: none
		sourceColumn: geo_id

	column country
		dataType: string
		lineageTag: 8d017cbf-6e0a-508a-bdd3-d38a22388191
		summarizeBy: none
		sourceColumn: country

	column region_group
		dataType: string
		lineageTag: f8680560-820a-5449-925b-f06c53925a9e
		summarizeBy: none
		sourceColumn: region_group

	partition DimGeo = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/dim_geo.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Checked = if Table.ColumnNames(Headers) = {"geo_id", "country", "region_group"} then Headers else error Error.Record("SchemaMismatch", "CSV headers do not match DimGeo", null),
					Typed = Table.TransformColumnTypes(Checked, {
					{"geo_id", Int64.Type},
					{"country", type text},
					{"region_group", type text}
					}, "en-US")
				in
					Typed
