table DimChannel
	lineageTag: f56e37aa-3783-52a5-9830-f7713a7a4df2

	column channel_id
		dataType: int64
		lineageTag: 4f14f363-86f9-5be1-80c6-22f0ca6997c3
		summarizeBy: none
		sourceColumn: channel_id

	column channel
		dataType: string
		lineageTag: 637a16f2-8ea2-51b2-802b-3d5bfbe9a762
		summarizeBy: none
		sourceColumn: channel

	partition DimChannel = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/dim_channel.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Checked = if Table.ColumnNames(Headers) = {"channel_id", "channel"} then Headers else error Error.Record("SchemaMismatch", "CSV headers do not match DimChannel", null),
					Typed = Table.TransformColumnTypes(Checked, {
					{"channel_id", Int64.Type},
					{"channel", type text}
					}, "en-US")
				in
					Typed
