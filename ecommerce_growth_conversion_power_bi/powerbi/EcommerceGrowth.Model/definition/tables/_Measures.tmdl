table _Measures
	lineageTag: 0a2173b5-32c6-41bb-87a8-f2e2c49a3b69

	measure Sessions = DISTINCTCOUNT(FactSessions[session_id])
		formatString: #,##0
		lineageTag: bbcb998c-e304-47b2-a6b4-ce6b01a46e2d

	measure Users = DISTINCTCOUNT(FactSessions[user_id])
		formatString: #,##0
		lineageTag: 67e5e8c8-8aec-417f-a9c8-5670a6290502

	measure 'Engaged Sessions' = CALCULATE([Sessions], FactSessions[engaged_session] = 1)
		formatString: #,##0
		lineageTag: 2206530d-98a0-495b-ba8e-280da27cc12c

	measure 'Engagement Rate' = DIVIDE([Engaged Sessions], [Sessions])
		formatString: 0.00%
		lineageTag: 417fbb84-6ab7-477f-a870-0630b088571a

	measure 'Product View Sessions' = CALCULATE([Sessions], FactSessions[view_item] = 1)
		formatString: #,##0
		lineageTag: 5b769603-97cb-439c-b7e5-102ade304bca

	measure 'Add to Cart Sessions' = CALCULATE([Sessions], FactSessions[add_to_cart] = 1)
		formatString: #,##0
		lineageTag: 95f17a11-2cd5-4b8d-bccf-9260da7eb16e

	measure 'Checkout Sessions' = CALCULATE([Sessions], FactSessions[begin_checkout] = 1)
		formatString: #,##0
		lineageTag: 3158e92f-c715-4fa5-9a74-b2face4a5519

	measure 'Purchase Sessions' = CALCULATE([Sessions], FactSessions[purchase] = 1)
		formatString: #,##0
		lineageTag: 87f7da79-0737-4b28-8bc3-ef77c14a553b

	measure 'Product View Rate' = DIVIDE([Product View Sessions], [Sessions])
		formatString: 0.00%
		lineageTag: 805d726b-29b6-472d-a5bc-5f38f0df482a

	measure 'View to Cart Rate' = DIVIDE([Add to Cart Sessions], [Product View Sessions])
		formatString: 0.00%
		lineageTag: ddb68628-1f15-45c4-b2e2-43bb8155f56f

	measure 'Cart to Checkout Rate' = DIVIDE([Checkout Sessions], [Add to Cart Sessions])
		formatString: 0.00%
		lineageTag: 3c818e59-14de-46ab-aeea-6af5d167b6ab

	measure 'Checkout to Purchase Rate' = DIVIDE([Purchase Sessions], [Checkout Sessions])
		formatString: 0.00%
		lineageTag: 2faa8b1b-cf3c-40bf-9fc3-c035c20b2b31

	measure 'Session Conversion Rate' = DIVIDE([Purchase Sessions], [Sessions])
		formatString: 0.00%
		lineageTag: 82039859-97e3-4cef-933b-d7d6f6ba6bbf

	measure Revenue = SUM(FactOrders[total_revenue])
		formatString: $#,##0.00
		lineageTag: 5fba5350-f29f-4ee7-97fd-39eda46a29a0

	measure Transactions = DISTINCTCOUNT(FactOrders[order_id])
		formatString: #,##0
		lineageTag: e11e114c-d041-4c74-8951-27e0631e2f4b

	measure AOV = DIVIDE([Revenue], [Transactions])
		formatString: $#,##0.00
		lineageTag: 479f9dce-30c9-42b8-a659-747d484bd50d

	measure 'Revenue per Session' = DIVIDE([Revenue], [Sessions])
		formatString: $#,##0.00
		lineageTag: 84955cf9-726f-4a53-bbdc-eae35ef44c98

	measure 'Revenue per User' = DIVIDE([Revenue], [Users])
		formatString: $#,##0.00
		lineageTag: 1bf4211c-1b84-43dc-a72a-3b6b757d44b7

	measure 'Units Sold' = SUM(FactOrders[total_quantity])
		formatString: #,##0
		lineageTag: 1dd03a0d-5e38-46df-a523-799eca552f2a

	measure Purchasers = DISTINCTCOUNT(FactOrders[user_id])
		formatString: #,##0
		lineageTag: 7146ab17-6790-485a-a872-a40b0c73fd52

	measure 'Repeat Purchasers' = VAR CustomerOrders = ADDCOLUMNS(VALUES(FactOrders[user_id]), "__OrderCount", CALCULATE(DISTINCTCOUNT(FactOrders[order_id]))) RETURN COUNTROWS(FILTER(CustomerOrders, [__OrderCount] > 1))
		formatString: #,##0
		lineageTag: 21c6f68c-990c-46ab-bf79-cee87ac12192

	measure 'Repeat Purchase Rate' = DIVIDE([Repeat Purchasers], [Purchasers])
		formatString: 0.00%
		lineageTag: 6a42e198-3c9d-428c-ba88-f24eb9fb055c

	measure 'New User Session Conversion' = DIVIDE(CALCULATE([Purchase Sessions], FactSessions[is_new_user] = 1), CALCULATE([Sessions], FactSessions[is_new_user] = 1))
		formatString: 0.00%
		lineageTag: fbab5784-4dbb-4bd4-aff1-9db32e62dcde

	measure 'Returning User Session Conversion' = DIVIDE(CALCULATE([Purchase Sessions], FactSessions[is_new_user] = 0), CALCULATE([Sessions], FactSessions[is_new_user] = 0))
		formatString: 0.00%
		lineageTag: 7f50238f-ef57-4649-80c0-5d2f92185f80

	measure 'Product Revenue' = SUM(FactOrderItems[item_revenue])
		formatString: $#,##0.00
		lineageTag: 2f1c736e-5d48-460f-939e-088caa6c7c30

	measure 'Product Units' = SUM(FactOrderItems[quantity])
		formatString: #,##0
		lineageTag: 6981a464-69e5-44ac-afb2-4d32553abb14

	measure 'Product Orders' = DISTINCTCOUNT(FactOrderItems[order_id])
		formatString: #,##0
		lineageTag: 1b7d9c76-a92f-4582-8444-344cf5c04eb5

	measure 'Average Selling Price' = DIVIDE([Product Revenue], [Product Units])
		formatString: $#,##0.00
		lineageTag: 93ad245d-b748-488c-a068-55f329c80e11

	measure 'Funnel Stage Sessions' = SWITCH(SELECTEDVALUE(FunnelStage[Stage]), "Sessions", [Sessions], "Product View", [Product View Sessions], "Add to Cart", [Add to Cart Sessions], "Checkout", [Checkout Sessions], "Purchase", [Purchase Sessions])
		formatString: #,##0
		lineageTag: 86f77585-a2dd-4857-8472-33630f2af1ca

	measure 'Revenue Previous Month' = CALCULATE([Revenue], DATEADD(DimDate[date], -1, MONTH))
		formatString: $#,##0.00
		lineageTag: dc9155a3-68f7-44ab-b25e-508a081353b4

	measure 'Revenue MoM %' = DIVIDE([Revenue] - [Revenue Previous Month], [Revenue Previous Month])
		formatString: 0.00%
		lineageTag: 0a182692-3966-463c-9b7e-8e33adfe6e7b

	column Dummy
		lineageTag: 5cb78e23-6a89-4042-89bd-3e6b4672f4ac
		isNameInferred
		sourceColumn: [Dummy]

	partition _Measures = calculated
		mode: import
		source = ROW("Dummy", BLANK())

