table DimDevice
	lineageTag: 5b99b014-800f-572f-bf11-a7e46fbeea85

	column device_id
		dataType: int64
		lineageTag: 4da25cfe-324b-5121-9136-cf9c7ab7c6d8
		summarizeBy: none
		sourceColumn: device_id

	column device_category
		dataType: string
		lineageTag: 38c0beee-c963-5cc8-999d-55a3b4ba4855
		summarizeBy: none
		sourceColumn: device_category

	partition DimDevice = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "/dim_device.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Checked = if Table.ColumnNames(Headers) = {"device_id", "device_category"} then Headers else error Error.Record("SchemaMismatch", "CSV headers do not match DimDevice", null),
					Typed = Table.TransformColumnTypes(Checked, {
					{"device_id", Int64.Type},
					{"device_category", type text}
					}, "en-US")
				in
					Typed
